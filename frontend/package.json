  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "20.19.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.0",
