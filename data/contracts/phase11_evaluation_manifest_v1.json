{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase11EvaluationManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "evaluation_run_id", "protocol_version",
    "metric_semantics_version", "dataset_version", "dataset_fingerprint",
    "split", "query_ids", "source_commit_sha", "source_tree_fingerprint",
    "status", "recorded_at", "started_at", "manifest_fingerprint"
  ],
  "properties": {
    "contract_version": {"const": "phase11_evaluation_manifest_v1"},
    "evaluation_run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "protocol_version": {"const": "phase11_eval_protocol_v1"},
    "metric_semantics_version": {"const": "phase11_metric_semantics_v1"},
    "dataset_version": {"const": "1.0.0"},
    "dataset_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split": {"enum": ["train", "dev", "test"]},
    "query_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["RUNNING", "COMPLETED", "FAILED", "INVALID"]},
    "recorded_at": {"type": "string"},
    "started_at": {"type": "string"},
    "ended_at": {"type": ["string", "null"]},
    "manifest_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strategy_config": {"type": ["object", "null"]},
    "candidate_pool_config": {"type": ["object", "null"]},
    "model_artifacts": {"type": ["object", "null"]},
    "feature_fingerprint": {"type": ["string", "null"]},
    "retrieval_document_version": {"type": ["string", "null"]},
    "retrieval_config_fingerprint": {"type": ["string", "null"]},
    "retrieval_index_fingerprint": {"type": ["string", "null"]},
    "judgment_policy": {"type": ["object", "null"]},
    "metric_specs": {"type": ["object", "null"]},
    "random_seed": {"type": ["integer", "null"]},
    "claim_limitations": {"type": ["array", "null"], "items": {"type": "string"}},
    "evaluation_input_fingerprint": {"type": ["string", "null"]},
    "dataset_contract": {"type": ["object", "null"]},
    "source_state": {"type": ["object", "null"]},
    "test_seal": {"type": ["object", "null"]},
    "test_execution_audit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "allow_test", "access_reason", "protocol_git_commit",
        "freeze_gate_attested", "phase4_test_exposure_acknowledged",
        "phase4_test_exposure_caveat", "prior_final_run_id",
        "prior_final_input_fingerprint"
      ],
      "properties": {
        "allow_test": {"const": true},
        "access_reason": {"enum": ["final", "reproduction"]},
        "protocol_git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "freeze_gate_attested": {"const": true},
        "phase4_test_exposure_acknowledged": {"const": true},
        "phase4_test_exposure_caveat": {"const": "post_exposure_fixed_synthetic_sandbox_evaluation"},
        "prior_final_run_id": {"type": ["string", "null"]},
        "prior_final_input_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "phase4_test_exposure": {"type": ["string", "null"]},
    "quality_result_fingerprint": {"type": ["string", "null"]},
    "file_sha256": {"type": ["object", "null"]},
    "warnings": {"type": ["array", "null"], "items": {"type": "string"}},
    "failure_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"split": {"const": "test"}}, "required": ["split"]},
      "then": {
        "required": ["test_seal", "test_execution_audit", "phase4_test_exposure"],
        "properties": {
          "test_seal": {"type": "object"},
          "test_execution_audit": {"type": "object"},
          "phase4_test_exposure": {"const": "post_exposure_fixed_synthetic_sandbox_benchmark"}
        }
      }
    }
  ]
}
