{
  "$defs": {
    "ExplanationFeedbackRecord": {
      "additionalProperties": false,
      "properties": {
        "feedback_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Feedback Id",
          "type": "string"
        },
        "contract_version": {
          "const": "feedback_record_v1",
          "default": "feedback_record_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "origin": {
          "const": "human",
          "default": "human",
          "title": "Origin",
          "type": "string"
        },
        "job_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "result_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Rank"
        },
        "comparison_candidate_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Candidate Id"
        },
        "comparison_result_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Result Rank"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "match_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Match Run Id",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "supersedes_feedback_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Feedback Id"
        },
        "feedback_type": {
          "const": "explanation",
          "title": "Feedback Type",
          "type": "string"
        },
        "explanation_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Explanation Run Id",
          "type": "string"
        },
        "match_explanation_id": {
          "exclusiveMinimum": 0,
          "title": "Match Explanation Id",
          "type": "integer"
        },
        "target_type": {
          "$ref": "#/$defs/ExplanationTargetType"
        },
        "value": {
          "$ref": "#/$defs/ExplanationVerdict"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 3,
              "pattern": "^(?:job_requirement:[A-Za-z0-9_.-]{1,100}|candidate:[1-9][0-9]*:(?:skill:[a-f0-9]{32,64}|project:[A-Za-z0-9_.-]{1,100}|project_evidence:[A-Za-z0-9_.-]{1,100})|(?:feature|ranking|retrieval|diagnostic):[1-9][0-9]*:[a-z][a-z0-9_.-]{0,79}|comparison:[1-9][0-9]*:top1:[a-z][a-z0-9_.-]{0,79})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Reference"
        }
      },
      "required": [
        "feedback_id",
        "job_id",
        "created_at",
        "match_run_id",
        "feedback_type",
        "explanation_run_id",
        "match_explanation_id",
        "target_type",
        "value"
      ],
      "title": "ExplanationFeedbackRecord",
      "type": "object"
    },
    "ExplanationTargetType": {
      "enum": [
        "summary",
        "match_reason",
        "risk",
        "missing_requirement",
        "interview_question",
        "top1_comparison",
        "rewrite_operation"
      ],
      "title": "ExplanationTargetType",
      "type": "string"
    },
    "ExplanationVerdict": {
      "enum": [
        "grounded",
        "unsupported",
        "misleading",
        "incomplete"
      ],
      "title": "ExplanationVerdict",
      "type": "string"
    },
