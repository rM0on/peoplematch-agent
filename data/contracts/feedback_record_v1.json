  "discriminator": {
    "mapping": {
      "explanation": "#/$defs/ExplanationFeedbackRecord",
      "profile_data": "#/$defs/ProfileDataFeedbackRecord",
      "ranking": "#/$defs/RankingFeedbackRecord"
    },
    "propertyName": "feedback_type"
  },
  "oneOf": [
