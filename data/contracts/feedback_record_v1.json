        "job_id",
        "created_at",
        "match_run_id",
        "feedback_type",
        "target_type",
        "value",
        "field_locator"
      ],
      "title": "ProfileDataFeedbackRecord",
      "type": "object"
    },
    "ProfileDataIssue": {
      "enum": [
        "missing_skill",
        "incorrect_skill",
        "missing_project_evidence",
        "incorrect_project_evidence_status",
        "incorrect_seniority",
        "incorrect_location",
        "incorrect_role_direction",
        "unclear_requirement",
        "missing_requirement",
        "incorrect_requirement_priority",
        "incorrect_seniority_requirement",
        "incorrect_location_constraint",
        "missing_expectation"
      ],
      "title": "ProfileDataIssue",
      "type": "string"
