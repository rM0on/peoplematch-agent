# PeopleMatch Agent local development settings
APP_NAME=PeopleMatch Agent Backend
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL (local Docker Compose values only)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=peoplematch
POSTGRES_USER=peoplematch
POSTGRES_PASSWORD=peoplematch_local
DATABASE_URL=postgresql+asyncpg://peoplematch:peoplematch_local@postgres:5432/peoplematch

# Infrastructure service URLs inside the Compose network
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Browser-to-backend URL and CORS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Legacy reserved field; current provider configuration is shared below.
LLM_API_KEY=

# Structured extraction. Keep mock for deterministic tests and offline demos.
# Select deepseek to reuse the OpenAI-compatible configuration below.
EXTRACTION_PROVIDER=mock
EXTRACTION_MAX_ATTEMPTS=2
EXTRACTION_TIMEOUT_SECONDS=10
EXTRACTION_MAX_OUTPUT_TOKENS=2048

# Phase 9 evidence-grounded explanation generation. Mock is deterministic/offline.
# To use the shared DeepSeek/OpenAI-compatible transport for extraction and/or
# explanation, select deepseek for the relevant provider and provide all three
# values locally. Never commit a real key.
EXPLANATION_PROVIDER=mock
EXPLANATION_MAX_ATTEMPTS=2
EXPLANATION_TIMEOUT_SECONDS=10
EXPLANATION_MAX_OUTPUT_TOKENS=1024
EXPLANATION_MAX_PROMPT_BYTES=131072
EXPLANATION_DEEPSEEK_BASE_URL=https://api.deepseek.com
EXPLANATION_DEEPSEEK_MODEL=deepseek-chat
EXPLANATION_DEEPSEEK_API_KEY=

# Phase 4 hybrid retrieval (local pretrained embedding; no API key)
RETRIEVAL_EMBEDDING_PROVIDER=sentence_transformers
RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_EMBEDDING_DIMENSION=384
RETRIEVAL_CANDIDATE_COLLECTION=peoplematch_candidates_retrieval_v1
RETRIEVAL_JOB_COLLECTION=peoplematch_jobs_retrieval_v1
RETRIEVAL_RRF_K=60
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_POOL_MINIMUM=20
RETRIEVAL_POOL_MULTIPLIER=3

# Phase 7 frozen Cross-Encoder (downloaded snapshot is ignored, not tracked)
# Native Settings defaults resolve these paths from the repository root;
# Compose supplies explicit /app paths in docker-compose.yml.
CROSS_ENCODER_BATCH_SIZE=10
